@tailwind base;
@tailwind components;
@tailwind utilities;

/* Importation des polices */
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;700;900&display=swap');

:root {
    --primary-color: #00FF00; /* Vert */
    --secondary-color: #FFFFFF; /* Blanc */
    --text-color: #FFFFFF; /* Blanc */
    --link-color: #00FF00; /* Vert */
    --link-hover-color: #00CC00; /* Vert foncé */
    --button-bg-color: #FFFFFF; /* Blanc */
    --button-text-color: #000000; /* Noir */
    --button-hover-bg-color: #00FF00; /* Vert */
    --button-hover-text-color: #FFFFFF; /* Blanc */
    --button-secondary-bg-color: #808080; /* Gris */
    --button-secondary-text-color: #FFFFFF; /* Blanc */
}

/* Application des polices */
body {
    font-family: 'Poppins', sans-serif;
    background-color: #131313;
}

.font-black {
    font-weight: 900;
}

.font-bold {
    font-weight: 700;
}

.font-regular {
    font-weight: 400;
}

/* Couleurs de texte et de liens */
.text-primary {
    color: var(--primary-color);
}

.text-secondary {
    color: var(--secondary-color);
}

.text-link {
    color: var(--link-color);
}

.text-link:hover {
    color: var(--link-hover-color);
}

/* Boutons */
.btn {
    background-color: var(--button-bg-color);
    color: var(--button-text-color);
    transition: background-color 0.3s, color 0.3s;
}

.btn:hover {
    background-color: var(--button-hover-bg-color);
    color: var(--button-hover-text-color);
}

.btn-secondary {
    background-color: var(--button-secondary-bg-color);
    color: var(--button-secondary-text-color);
}

.btn-secondary:hover {
    background-color: var(--button-hover-bg-color);
    color: var(--button-hover-text-color);
}