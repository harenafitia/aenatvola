{
  "rewrites": [{
    "source": "/(.*)",
    "destination": "/"
  }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' 'inline-speculation-rules';"
        }
      ]
    }
  ],
  "redirects": []
}